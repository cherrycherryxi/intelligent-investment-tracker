APP_NAME=intelligent-investment-tracker
ENVIRONMENT=local
DEBUG=false

DATABASE_URL=sqlite:///./investment_tracker.db
DATABASE_ECHO=false

LOG_LEVEL=INFO
LOG_DIR=logs
LOG_FILENAME=app.log
LOG_JSON=true

OCR_PROVIDER=tesseract
OCR_CONFIDENCE_THRESHOLD=0.8
BAIDU_OCR_API_KEY=
BAIDU_OCR_SECRET_KEY=
TENCENT_OCR_SECRET_ID=
TENCENT_OCR_SECRET_KEY=

EXCHANGE_RATE_PRIMARY_URL=
EXCHANGE_RATE_FALLBACK_URL=
EXCHANGE_RATE_CACHE_TTL_SECONDS=900

AI_PROVIDER=deepseek
AI_MODEL_NAME=deepseek-reasoner
AI_TEMPERATURE=0.2
AI_MAX_TOKENS=4000
AI_API_KEY=

